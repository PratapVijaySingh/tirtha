# Google AdSense (https://www.google.com/adsense/)
# After Google approves https://tirtha-ten.vercel.app, set these on Vercel
# and in .env.local, then redeploy. ads.txt is generated at build time.
VITE_ADSENSE_CLIENT=ca-pub-8477220804590015
VITE_ADSENSE_SLOT=

# Optional Cesium ion token (https://ion.cesium.com/tokens). When set, desktop
# uses Cesium World Terrain with a water mask for ocean sun glint. Terrain can
# soften satellite photos at shrine scale, so leave empty to keep the ellipsoid.
VITE_CESIUM_ION_TOKEN=
